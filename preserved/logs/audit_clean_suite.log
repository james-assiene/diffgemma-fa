    def test_mar_confidence_also_drives_the_stopping_rule():
        """SPEC §3.4: "`--confidence={mf,mar}` selects the entropy source. **Note it
        changes stopping as well as acceptance** (the same tensor feeds both)."
    
        Constructed so the two answers are maximally far apart: the stub logits are
        uniform (`H(p) = log V`, ~2.08 nats) while the automaton admits exactly one
        string of the canvas length, so `H(q_i) = 0` at every position. An
        entropy-threshold stopping rule must therefore fire immediately under `mar`
        and never under `mf`.
    
        Measured by counting executed denoising steps through `DIAGNOSTICS`, not by
        reading the source.
        """
        V = 8
        members = ({2}, {3}, {4}, {1}, set(range(V)))
        edges = ((0, 1, 0), (1, 2, 1), (2, 3, 2), (3, 4, 3), (4, 4, 4))
        spec = _Spec(n_states=5, bucket=8, vocab=V, edges=edges, members=members,
                     is_neg=(False,) * 5, finals=frozenset({4}),
                     start=frozenset({0}))
        L = 4                       # exactly one accepted string: (2, 3, 4, EOS)
        assert _enumerate_language(spec, L) == [(2, 3, 4, 1)]
        logits = jnp.zeros((1, L, spec.vocab))
    
        @dataclasses.dataclass(frozen=True)
        class _EntropyStop:
            threshold: float = 0.005
    
            def should_stop(self, *, step, canvas, previous_canvas, logits):
