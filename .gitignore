.venv/
.jax_cache/
.hf/
logs/
# Excluded as `artifacts/*` rather than `artifacts/` so the negation below can
# re-include specific files — git cannot un-ignore anything inside a directory
# that is itself excluded.
artifacts/*
# Keep the small Phase 0 measurement artifacts: they are the evidence behind
# docs/PHASE0_FINDINGS.md and the SPEC corrections. ~40 KB total.
!artifacts/phase0_*.json
__pycache__/
*.pyc
# BFCL / benchmark checkouts live under artifacts/data (large, upstream-owned)
artifacts/data/
